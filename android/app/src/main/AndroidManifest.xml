<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WiFi reconnect: read whether WiFi is on + suggest networks the owner
         enters (both normal permissions, no runtime prompt). The app can
         never turn WiFi on itself — the owner does that from the WiFi panel. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Requested separately, only after foreground location is granted (Android 11+ rule). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Runtime permission on Android 13+; requested before tracking starts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 requires the per-type permission matching foregroundServiceType. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Ring vibrates while ringing. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- SIM-change detection reads the active subscription ids (consent step 4). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Lost Mode shows its screen over the lock screen via full-screen intent. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Decoy lock: draws the Lost Mode screen over every app. The user
         grants this in Settings ("Display over other apps"); without it
         Lost Mode falls back to the notification + LostModeActivity. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Boot receiver: Lost Mode comes back after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".OpenGuardApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenGuard">
        <!-- allowBackup=false: tokens live in EncryptedSharedPreferences whose
             Keystore keys are not backed up, so a restore would corrupt them. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.security.LostModeActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".feature.security.EraseCountdownActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".core.location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".core.security.RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".core.security.OpenGuardDeviceAdmin"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
        </receiver>

        <receiver
            android:name=".core.security.SimChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telephony.action.SIM_CARD_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.security.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Power-menu guard: dismisses the system power menu while Lost
             Mode is on. The user enables it in Accessibility settings;
             it watches only for the power menu window and reads no
             screen content (see accessibility_service_config). -->
        <service
            android:name=".core.security.PowerMenuGuardService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
