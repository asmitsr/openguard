    <string name="ring_notification_stop">Stop</string>

    <string name="lost_mode_channel_name">Lost Mode</string>
    <string name="lost_mode_notification_title">Lost Mode is on</string>
    <string name="lost_mode_notification_text">This phone is marked as lost. Tap to see the owner message.</string>

    <string name="security_channel_name">Security alerts</string>
    <string name="sim_notification_title">SIM card changed</string>
    <string name="sim_notification_text">Check if this was you — open OpenGuard to review.</string>

    <string name="wifi_offline_notification_title">You are offline — WiFi is off</string>
    <string name="wifi_offline_notification_text">Turn WiFi on so OpenGuard can reach this phone again.</string>
    <string name="wifi_offline_notification_action">Turn on WiFi</string>

    <string name="erase_channel_name">Remote erase</string>
    <string name="erase_notification_title">Erase countdown started</string>
    <string name="erase_notification_text">This phone will be erased in 60 seconds. Tap to abort.</string>

    <string name="device_admin_label">OpenGuard device admin</string>
    <string name="device_admin_description">Lets OpenGuard lock this phone when you send a Lock or Lost Mode command, and erase it when you send an Erase command.</string>
    <string name="device_admin_explanation">OpenGuard uses device admin only to lock this phone when you send a Lock or Lost Mode command, and to erase it when you send an Erase command. It never sets or changes your password, and you can remove it anytime from Settings.</string>

    <string name="power_menu_guard_description">Blocks the power-off menu while Lost Mode is on, so a lost phone cannot be switched off from the power menu. OpenGuard only watches for the power menu window; it does not read screen content.</string>

    <string name="evidence_channel_name">Evidence recording</string>
    <string name="evidence_channel_description">Shows while Lost Mode records evidence clips</string>
    <string name="evidence_notification_title">Recording evidence (Lost Mode)</string>
    <string name="evidence_notification_text">OpenGuard is recording short clips while Lost Mode is on. The camera and microphone indicators stay visible.</string>

    <string name="bluetooth_channel_name">Bluetooth</string>
    <string name="bluetooth_notification_title">Turn on Bluetooth?</string>
    <string name="bluetooth_notification_text">OpenGuard was asked to turn on Bluetooth. Tap to allow it — Android does not let apps turn Bluetooth on silently.</string>

