# OpenGuard self-host config. Copy to .env and fill in — never commit .env.
# Used by docker-compose.yml (api reads it via env_file; db reads
# POSTGRES_PASSWORD). Also used by local non-Docker runs:
#   DATABASE_URL=... PORT=8787 node backend/dist-node/server.js

# Postgres password. Also used inside DATABASE_URL below — keep them in sync.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# The API's database URL. Inside compose, the host is the `db` service and
# the password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://openguard:change-me-to-a-long-random-password@db:5432/openguard

# Host port for the dashboard + API (the container always listens on 8787).
PORT=8787

# WebAuthn relying-party config for passkeys (non-secret public config).
# The API origin the browser talks to — RP_ID must be its domain. When
# unset, the passkeys routes default to the Workers deployment values
# (openguard-api.asmitsr.workers.dev / OpenGuard /
# https://openguard-api.asmitsr.workers.dev). For a self-hosted domain,
# set all three to match it.
RP_ID=openguard-api.asmitsr.workers.dev
RP_NAME=OpenGuard
RP_ORIGIN=https://openguard-api.asmitsr.workers.dev
